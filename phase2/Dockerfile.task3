# Offline review and JSONL policy boundary; does not actuate hardware.
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/phase2
WORKDIR /app
COPY phase2/task3_submission/requirements-review.txt /tmp/requirements-review.txt
RUN pip install --no-cache-dir -r /tmp/requirements-review.txt
COPY phase2/ebim_phase2/ /app/phase2/ebim_phase2/
COPY phase2/tests/ /app/phase2/tests/
COPY phase2/task3_submission/ /app/phase2/task3_submission/
COPY phase2/hardware/task3_onsite/ /app/phase2/hardware/task3_onsite/
COPY phase2/scripts/probe_hardware.py phase2/scripts/probe_franka_state.cpp /app/phase2/scripts/
COPY skills/ebim-task3-phase2/ /app/skills/ebim-task3-phase2/
COPY phase2/Dockerfile.task3 phase2/Dockerfile.task3.dockerignore /app/phase2/
USER 65532:65532
ENTRYPOINT ["python", "/app/phase2/task3_submission/review.py"]
CMD ["review"]
