#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
set -Eeuo pipefail

ebim_root="${EBIM_ROOT:-/workspace/EBiM_Challenge}"
solution_root="${ebim_root}/ebim-track3-solution"
asset_path="${ebim_root}/task1_isaacsim/assets/Robotiq_2f_85_with_d405_mobile_fr3_duo_v0_2.usd"
room_path="${ebim_root}/assets/robot_room.usd"
expected_commit="${EBIM_COMMIT:-cb5184574f33611f943ff42aae461678ccb538e9}"
expected_room_sha256="${ROOM_ASSET_SHA256:-696c71577f1874d815fe29c6a58c65f0f1a0a0fb15c0d8adbb5105209f5ff883}"
expected_asset_sha256="${ROBOT_ASSET_SHA256:-aa1a833de48cc543c73957461dab82fe0979320b7c0b6a0a113d24b500075e5c}"
log_dir="${AIRSIGN_LOG_DIR:-/tmp/airsign}"
isaac_python="${AIRSIGN_PYTHON:-/isaac-sim/python.sh}"
revision_file="${AIRSIGN_REVISION_FILE:-/opt/airsign/benchmark-commit}"

usage() {
  cat <<'EOF'
AirSignRobot — EBiM Task 3 container

Usage:
  airsign smoke
  airsign participant [controller options]
  airsign gripper-gate [controller options]
  airsign stage1-table-setup [controller options]
  airsign four-stage-rehearsal [controller options]
  airsign validate-replay DIRECTORY
  airsign shell [command ...]

Commands:
  smoke         Static, GPU-free image and source-integrity checks.
  participant   Run the actuator-driven dual-arm and mobile-base workload.
  gripper-gate  Run the Robotiq open/close/open and scene-inventory gate.
  stage1-table-setup
                Run physical cup or tray Stage 1 development gates.
  four-stage-rehearsal
                Record a truth-bounded four-stage actuator replay.
  validate-replay
                Validate replay schema, hashes, and claim boundaries.
  shell         Open a shell, or execute the supplied command.
  help          Show this message.

The participant, gripper-gate, and stage1-table-setup commands are development
workloads. They do not claim an official EBiM stage completion or score.
EOF
}

verify_image() {
  local actual_commit actual_room_sha256 actual_asset_sha256
  test -x "${isaac_python}"
  test -d "${ebim_root}/task3_isaacsim"
  test -f "${room_path}"
  test -f "${solution_root}/autonomous_probe.py"
  test -f "${solution_root}/gripper_scene_gate2.py"
  test -f "${solution_root}/base_motion_monitor.py"
  test -f "${solution_root}/isaac_collision_geometry.py"
  test -f "${solution_root}/joint_command_guard.py"
  test -f "${solution_root}/se2_route_validator.py"
  test -f "${solution_root}/stage1_table_setup.py"
  test -f "${solution_root}/four_stage_rehearsal.py"
  test -f "${solution_root}/validate_four_stage_replay.py"
  test -f "${asset_path}"

  if [[ -f "${revision_file}" ]]; then
    actual_commit="$(tr -d '[:space:]' < "${revision_file}")"
  elif command -v git >/dev/null 2>&1; then
    actual_commit="$(git -C "${ebim_root}" rev-parse HEAD)"
  else
    echo "No benchmark revision stamp is available." >&2
    return 1
  fi
  if [[ "${actual_commit}" != "${expected_commit}" ]]; then
    echo "Official benchmark revision mismatch: ${actual_commit}" >&2
    return 1
  fi

  actual_room_sha256="$(sha256sum "${room_path}" | awk '{print $1}')"
  if [[ "${actual_room_sha256}" != "${expected_room_sha256}" ]]; then
    echo "Task 3 room asset checksum mismatch: ${actual_room_sha256}" >&2
    return 1
  fi

  actual_asset_sha256="$(sha256sum "${asset_path}" | awk '{print $1}')"
  if [[ "${actual_asset_sha256}" != "${expected_asset_sha256}" ]]; then
    echo "Robotiq asset checksum mismatch: ${actual_asset_sha256}" >&2
    return 1
  fi

  "${isaac_python}" - "${solution_root}/autonomous_probe.py" \
      "${solution_root}/gripper_scene_gate2.py" \
      "${solution_root}/base_motion_monitor.py" \
      "${solution_root}/isaac_collision_geometry.py" \
      "${solution_root}/joint_command_guard.py" \
      "${solution_root}/se2_route_validator.py" \
      "${solution_root}/stage1_table_setup.py" \
      "${solution_root}/four_stage_rehearsal.py" \
      "${solution_root}/validate_four_stage_replay.py" <<'PY'
from pathlib import Path
import sys

for value in sys.argv[1:]:
    path = Path(value)
    compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY
}

require_gpu() {
  if [[ ! -c /dev/nvidiactl ]]; then
    echo "No NVIDIA GPU device is available. Run Docker with --gpus all." >&2
    return 1
  fi
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,driver_version,memory.total \
      --format=csv,noheader
  fi
}

run_probe() {
  local label="$1"
  local result_prefix="$2"
  local script="$3"
  shift 3

  verify_image
  require_gpu
  mkdir -p "${log_dir}"
  local log_file="${log_dir}/${label}.log"

  set +e
  "${isaac_python}" "${script}" "$@" 2>&1 | tee "${log_file}"
  local python_status="${PIPESTATUS[0]}"
  set -e

  if [[ "${python_status}" -ne 0 ]]; then
    echo "${label} exited with status ${python_status}." >&2
    return "${python_status}"
  fi
  if ! grep -Eq "^${result_prefix} .*\"passed\": true" "${log_file}"; then
    echo "${label} did not emit a passing machine-readable result." >&2
    return 1
  fi
  echo "${label} passed. Full log: ${log_file}"
}

command="${1:-smoke}"
shift || true
case "${command}" in
  smoke)
    verify_image
    echo "AIRSIGN_SMOKE_RESULT {\"passed\":true,\"benchmark_commit\":\"${expected_commit}\",\"robot_profile\":\"robotiq\",\"simulator\":\"Isaac Sim 5.1.0\"}"
    ;;
  participant)
    run_probe \
      "participant" \
      "AUTONOMOUS_PROBE_RESULT" \
      "${solution_root}/autonomous_probe.py" \
      "$@"
    ;;
  gripper-gate)
    run_probe \
      "gripper-gate" \
      "GRIPPER_SCENE_GATE2_RESULT" \
      "${solution_root}/gripper_scene_gate2.py" \
      "$@"
    ;;
  stage1-table-setup)
    run_probe \
      "stage1-table-setup" \
      "STAGE1_TABLE_SETUP_RESULT" \
      "${solution_root}/stage1_table_setup.py" \
      "$@"
    ;;
  four-stage-rehearsal)
    run_probe \
      "four-stage-rehearsal" \
      "FOUR_STAGE_REHEARSAL_RESULT" \
      "${solution_root}/four_stage_rehearsal.py" \
      "$@"
    ;;
  validate-replay)
    if [[ "$#" -ne 1 ]]; then
      echo "validate-replay requires exactly one evidence directory." >&2
      exit 2
    fi
    exec "${isaac_python}" \
      "${solution_root}/validate_four_stage_replay.py" \
      "$1"
    ;;
  shell)
    if [[ "$#" -gt 0 ]]; then
      exec "$@"
    fi
    exec /bin/bash
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
